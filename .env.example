# --- Prozorro ---
PROZORRO_API_URL=https://public.api.openprocurement.org/api/2.5
# ISO-дата/час початку сканування або offset з логу попереднього запуску.
# Якщо порожньо — останні 30 днів.
PROZORRO_OFFSET_FROM=2026-09-01T00:00:00+03:00
# Необов'язково: зупинитися, коли dateModified перевищить цю дату
PROZORRO_DATE_TO=
PROZORRO_PAGE_LIMIT=100
# Необов'язково: ліміт сторінок стрічки (зручно для тестового прогону)
PROZORRO_MAX_PAGES=
PROZORRO_WORKERS=4
# Мінімальний інтервал між будь-якими двома запитами до Prozorro, сек
PROZORRO_REQUEST_DELAY=0.15

# --- HTTP ---
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=5

# --- Збагачення (Opendatabot). Порожній ключ => усі компанії "Unenriched" ---
OPENDATABOT_API_KEY=
OPENDATABOT_API_URL=https://opendatabot.com/api/v3
ENRICHMENT_DELAY=0.5

# --- Результат ---
OUTPUT_PATH=b2b_drone_manufacturers.json